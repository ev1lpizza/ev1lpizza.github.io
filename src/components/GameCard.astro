---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '../data/site';

interface Props { game: CollectionEntry<'games'>; isNew?: boolean }
const { game, isNew = false } = Astro.props;
const g = game.data;
const useCanvas = !g.cover || !!g.attract;
---
<a class="card" href={url(`games/${game.id}/`)} aria-label={`${g.title}: ${g.tagline}`}>
  <div class="screen" style={`view-transition-name: screen-${game.id}`}>
    {useCanvas
      ? <canvas data-attract={g.attract ?? 'default'} aria-hidden="true"></canvas>
      : g.cover && <Image src={g.cover} alt="" widths={[400, 800]} sizes="(min-width: 1040px) 33vw, 100vw" />}
    {isNew && <span class="new">New</span>}
    <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg></span>
  </div>
  <h3>{g.title}</h3>
</a>

<style>
  .card { display: grid; gap: 14px; min-width: 0; text-decoration: none; }
  .screen { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r); background: var(--plate); overflow: hidden; transition: transform .4s var(--ease-out); }
  .card:hover .screen, .card:focus-visible .screen { transform: translateY(-4px); }
  .card:active .screen { transform: scale(.985); }
  .screen canvas, .screen :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; object-fit: cover; }
  .screen canvas { image-rendering: pixelated; }
  .new { position: absolute; top: 14px; left: 14px; padding: 5px 12px; border-radius: 999px; background: var(--cheese); color: var(--ground); font-size: 13px; font-weight: 700; }
  .play { position: absolute; right: 14px; bottom: 14px; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: var(--cheese); color: var(--ground); opacity: 0; transform: scale(.9); transition: opacity .25s, transform .25s var(--ease-out); }
  .play svg { width: 22px; height: 22px; }
  .card:hover .play, .card:focus-visible .play { opacity: 1; transform: none; }
  @media (hover: none) { .play { opacity: 1; transform: none; } }
  h3 { margin: 0; font-size: clamp(20px, 2vw, 26px); }
</style>

<script>
  import { mountAttract } from '../scripts/attract';
  document.querySelectorAll<HTMLAnchorElement>('.card').forEach((card) => {
    let hover = false;
    const cv = card.querySelector<HTMLCanvasElement>('canvas[data-attract]');
    if (cv) mountAttract(cv, cv.dataset.attract!, () => hover, 0.5);
    card.addEventListener('pointerenter', () => (hover = true));
    card.addEventListener('pointerleave', () => (hover = false));
    card.addEventListener('focus', () => (hover = true));
    card.addEventListener('blur', () => (hover = false));
  });
</script>
