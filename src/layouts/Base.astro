---
import '@fontsource/bungee/400.css';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import { SITE, url } from '../data/site';
import Logo from '../components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = SITE.description, image = url('og.png') } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · Web games`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;
const here = (p: string) => (path === url(p) ? 'page' : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#110a09" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} devlog`} href={url('rss.xml')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        var d = document.documentElement;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
        if (sessionStorage.getItem('ev1l:evil') === '1') d.classList.add('evil');
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="bar">
      <div class="wrap">
        <a class="logo" href={url('')} aria-label={`${SITE.name} home`}><Logo /><span>Ev1l Pizza</span></a>
        <nav aria-label="Main">
          <a href={url('#games')}>Games</a>
          <a href={url('devlog/')} aria-current={path.startsWith(url('devlog/')) ? 'page' : undefined}>Devlog</a>
        </nav>
      </div>
    </header>

    <main id="content" tabindex="-1">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <p>© {new Date().getFullYear()} {SITE.handle}</p>
        <nav aria-label="Site info">
          <a href={url('privacy/')} aria-current={here('privacy/')}>Privacy</a>
          <a href={url('terms/')} aria-current={here('terms/')}>Terms</a>
          <a href={url('accessibility/')} aria-current={here('accessibility/')}>Accessibility</a>
          <a href={url('credits/')} aria-current={here('credits/')}>Credits</a>
          <a href={url('rss.xml')}>RSS</a>
          <a href={SITE.github} rel="me noopener">GitHub</a>
        </nav>
      </div>
    </footer>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style is:global>
  .bar { position: relative; z-index: 20; }
  .bar .wrap { display: flex; align-items: center; justify-content: space-between; gap: 20px; height: 76px; }
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--f-display); font-size: 17px; white-space: nowrap; }
  .logo svg { width: 32px; height: 32px; flex: none; transition: transform .5s var(--ease-out); }
  .logo:hover svg { transform: rotate(-14deg) scale(1.06); }
  .bar nav { display: flex; gap: 6px; }
  .bar nav a { text-decoration: none; font-weight: 600; font-size: 16px; padding: 10px 14px; border-radius: 999px; transition: background-color .2s; }
  .bar nav a:hover { background: var(--plate-2); }
  .bar nav a[aria-current] { background: var(--plate); }
  @media (max-width: 400px) { .logo span { display: none; } }

  main:focus { outline: none; }

  .foot { margin-top: auto; padding-block: 36px max(36px, env(safe-area-inset-bottom, 0px)); color: var(--ash); font-size: 15px; }
  .foot .wrap { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 28px; }
  .foot p { margin: 0; }
  .foot nav { display: flex; flex-wrap: wrap; gap: 6px 20px; }
  .foot a { text-decoration: none; transition: color .2s; }
  .foot a:hover, .foot a[aria-current] { color: var(--cream); text-decoration: underline; }
</style>
