---
import '@fontsource/bungee/400.css';
import '@fontsource-variable/instrument-sans';
import '@fontsource/martian-mono/400.css';
import '@fontsource/martian-mono/800.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { SITE, url } from '../data/site';
import Logo from '../components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = SITE.description, image = url('og.png') } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · Web games`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const games = (await getCollection('games', ({ data }) => !data.draft)).sort((a, b) => +b.data.released - +a.data.released);
const paletteData = [
  ...games.map((g) => ({ label: g.data.title, kind: 'Game', href: url(`games/${g.id}/`) })),
  { label: 'Home', kind: 'Page', href: url('') },
  { label: 'Devlog', kind: 'Page', href: url('#devlog') },
  { label: 'Privacy policy', kind: 'Page', href: url('privacy/') },
  { label: 'Terms of use', kind: 'Page', href: url('terms/') },
  { label: 'Accessibility', kind: 'Page', href: url('accessibility/') },
  { label: 'Credits and licenses', kind: 'Page', href: url('credits/') },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#170809" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} devlog`} href={url('rss.xml')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        var d = document.documentElement, c = localStorage.getItem('ev1l:calm');
        if (c === '1' || (c === null && matchMedia('(prefers-reduced-motion: reduce)').matches)) d.classList.add('calm');
        if (sessionStorage.getItem('ev1l:evil') === '1') d.classList.add('evil');
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="hud">
      <div class="wrap">
        <a class="logo" href={url('')} aria-label={`${SITE.name} home`}><Logo /><span>EV1L<b>PIZZA</b></span></a>
        <nav aria-label="Main">
          <a href={url('#rack')}>Games</a>
          <a href={url('#devlog')}>Devlog</a>
        </nav>
        <div class="hud-right">
          <div class="score" title="Points from the homepage and from games. Saved only in this browser.">
            <span class="lbl">SCORE </span><output id="score" aria-live="off">000000</output>
          </div>
          <button class="chip-btn" id="soundBtn" aria-pressed="false" title="Sound effects"><span aria-hidden="true">♪</span><span class="lbl"> Sound</span><span class="sr-only">Sound effects</span></button>
          <button class="chip-btn" id="calmBtn" aria-pressed="false" title="Calm mode pauses animation"><span aria-hidden="true">◐</span><span class="lbl"> Calm</span><span class="sr-only">Calm mode</span></button>
          <button class="chip-btn" id="paletteBtn" title="Search (Ctrl+K)"><span aria-hidden="true">⌕</span><span class="lbl"> Search</span><kbd>⌘K</kbd><span class="sr-only">Search games and pages</span></button>
        </div>
      </div>
    </header>

    <main id="content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-brand">
          <a class="logo" href={url('')}><Logo /><span>EV1L<b>PIZZA</b></span></a>
          <p>No cookies, no tracking, no ads. High scores stay in your browser.</p>
        </div>
        <nav aria-label="Legal and info" class="foot-links">
          <a href={url('privacy/')} aria-current={path.endsWith('/privacy/') ? 'page' : undefined}>Privacy</a>
          <a href={url('terms/')} aria-current={path.endsWith('/terms/') ? 'page' : undefined}>Terms</a>
          <a href={url('accessibility/')} aria-current={path.endsWith('/accessibility/') ? 'page' : undefined}>Accessibility</a>
          <a href={url('credits/')} aria-current={path.endsWith('/credits/') ? 'page' : undefined}>Credits</a>
          <a href={url('rss.xml')}>RSS</a>
          <a href={SITE.github} rel="me noopener">GitHub</a>
        </nav>
        <p class="mono foot-fine">© {new Date().getFullYear()} {SITE.handle} · Psst: try the Konami code</p>
      </div>
    </footer>

    <div class="palette" id="palette" hidden>
      <div class="palette-box" role="dialog" aria-modal="true" aria-label="Search games and pages">
        <input id="paletteInput" type="text" placeholder="Search games, pages, or try “evil”" autocomplete="off" role="combobox" aria-expanded="true" aria-controls="paletteList" aria-label="Search" />
        <ul id="paletteList" role="listbox" aria-label="Results"></ul>
        <p class="palette-hint mono">↑ ↓ to move · Enter to open · Esc to close</p>
      </div>
    </div>
    <script type="application/json" id="palette-data" set:html={JSON.stringify(paletteData)} />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style is:global>
  .hud {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50;
    background: color-mix(in oklab, var(--sauce) 80%, transparent);
    backdrop-filter: blur(12px) saturate(140%); -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid var(--char);
  }
  .hud .wrap { display: flex; align-items: center; gap: 20px; height: 60px; }
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--f-display); font-size: 17px; letter-spacing: .02em; white-space: nowrap; }
  .logo svg { width: 30px; height: 30px; flex: none; }
  .logo b { color: var(--cheese); font-weight: 400; }
  .hud nav { display: flex; gap: 18px; margin-left: 12px; }
  .hud nav a { text-decoration: none; color: var(--ash); font-size: 14px; font-weight: 500; }
  .hud nav a:hover { color: var(--cream); }
  .hud-right { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  .score { font-family: var(--f-mono); font-size: 12px; color: var(--ash); letter-spacing: .06em; white-space: nowrap; margin-right: 4px; }
  .score output { color: var(--cheese); font-weight: 800; font-variant-numeric: tabular-nums; display: inline-block; min-width: 6ch; text-align: right; }
  @media (max-width: 820px) {
    .hud nav, .score .lbl, .chip-btn .lbl, .chip-btn kbd { display: none; }
    .hud .wrap { gap: 10px; }
  }
  @media (max-width: 360px) { .logo span { display: none; } }

  .site-footer { border-top: 1px solid var(--char); padding-block: 40px 48px; color: var(--ash); margin-top: auto; }
  .site-footer .wrap { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 20px 32px; align-items: start; }
  .foot-brand p { margin: 10px 0 0; max-width: 40ch; font-size: 14.5px; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 10px 22px; font-size: 14.5px; }
  .foot-links a { text-decoration: none; }
  .foot-links a:hover, .foot-links a[aria-current] { color: var(--cream); text-decoration: underline; text-underline-offset: 4px; }
  .foot-fine { grid-column: 1 / -1; margin: 6px 0 0; }
  @media (max-width: 700px) { .site-footer .wrap { grid-template-columns: minmax(0, 1fr); } }

  .palette { position: fixed; inset: 0; z-index: 90; display: grid; justify-items: center; align-items: start; padding: 14vh var(--gutter-r) 16px var(--gutter); background: rgba(5,2,3,.6); }
  .palette-box { width: min(560px, 100%); background: var(--crust); border: 1px solid var(--char); border-radius: 16px; overflow: hidden; box-shadow: 0 30px 80px -20px #000; }
  .palette input { width: 100%; height: 56px; padding: 0 18px; border: 0; border-bottom: 1px solid var(--char); background: transparent; color: var(--cream); font: 16px var(--f-body); outline: none; }
  .palette ul { list-style: none; margin: 0; padding: 6px; max-height: 340px; overflow: auto; }
  .palette li { display: flex; justify-content: space-between; gap: 12px; padding: 11px 12px; border-radius: 10px; cursor: pointer; }
  .palette li[aria-selected="true"] { background: var(--char); }
  .palette li.empty { color: var(--ash); cursor: default; }
  .palette li small { font-family: var(--f-mono); font-size: 10px; color: var(--ash); text-transform: uppercase; letter-spacing: .08em; }
  .palette-hint { margin: 0; padding: 10px 18px; border-top: 1px solid var(--char); color: var(--ash); font-size: 10px; }
</style>
