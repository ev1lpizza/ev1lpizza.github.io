---
import Base from './Base.astro';
import { fmtDate } from '../data/site';

interface Props { title: string; description: string; date?: Date; updated?: Date }
const { title, description, date, updated } = Astro.props;
const stamp = date ?? updated;
---
<Base title={title} description={description}>
  <article class="wrap doc">
    <header>
      <h1>{title}</h1>
      {stamp && (
        <p class="muted stamp">
          {updated && !date && 'Updated '}<time datetime={stamp.toISOString().slice(0, 10)}>{fmtDate(stamp, { month: 'long', day: 'numeric', year: 'numeric' })}</time>
        </p>
      )}
    </header>
    <div class="prose"><slot /></div>
  </article>
</Base>

<style>
  .doc { padding-block: clamp(40px, 8vw, 104px) clamp(64px, 9vw, 120px); }
  header { margin-bottom: clamp(32px, 5vw, 56px); max-width: 18ch; }
  h1 { font-size: clamp(40px, 7vw, 88px); margin: 0; }
  .stamp { margin: 18px 0 0; font-size: 16px; }
  .prose { max-width: 66ch; font-size: 17px; }
  .prose :global(h2) { font-family: var(--f-body); font-weight: 700; font-size: clamp(21px, 2.2vw, 25px); letter-spacing: 0; line-height: 1.2; margin: 48px 0 10px; }
  .prose :global(h3) { font-family: var(--f-body); font-weight: 700; font-size: 18px; margin: 24px 0 6px; }
  .prose :global(p), .prose :global(li) { line-height: 1.7; }
  .prose :global(ul) { padding-left: 1.2em; }
  .prose :global(li + li) { margin-top: 6px; }
  .prose :global(a) { color: var(--cheese); }
  .prose :global(code) { font-family: ui-monospace, "SFMono-Regular", Menlo, monospace; font-size: .86em; color: var(--cheese); overflow-wrap: anywhere; }
  .prose :global(.summary) { background: var(--plate); border-radius: var(--r); padding: 20px 24px; margin: 0 0 8px; }
  .prose :global(.summary strong) { display: block; margin-bottom: 8px; }
  .prose :global(.summary ul) { margin: 0; }
  .prose :global(.table-wrap) { overflow-x: auto; margin: 16px 0; background: var(--plate); border-radius: 14px; }
  .prose :global(table) { border-collapse: collapse; width: 100%; font-size: 15px; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 12px 16px; vertical-align: top; }
  .prose :global(tbody tr:nth-child(odd)) { background: color-mix(in oklab, var(--plate-2) 55%, transparent); }
  .prose :global(th) { font-size: 14px; color: var(--ash); font-weight: 600; }
</style>
