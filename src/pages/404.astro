---
import Base from '../layouts/Base.astro';
import Pie from '../components/Pie.astro';
import { url } from '../data/site';
---
<Base title="Page not found">
  <section class="wrap lost" aria-labelledby="lost-h">
    <div class="art"><Pie interactive={false} missing={1} seed={11} /></div>
    <div class="copy">
      <h1 id="lost-h">404</h1>
      <p>This page isn’t here.</p>
      <a class="btn primary" href={url('')}>Home</a>
    </div>
  </section>
</Base>
<style>
  .lost { padding-block: clamp(40px, 8vw, 96px); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(24px, 5vw, 72px); }
  .art { max-width: 520px; width: 100%; justify-self: center; }
  h1 { font-size: clamp(88px, 16vw, 220px); margin: 0; line-height: .85; }
  p { font-size: 20px; color: var(--ash); margin: 18px 0 28px; }
  @media (max-width: 760px) { .lost { grid-template-columns: minmax(0, 1fr); } .art { max-width: 340px; } }
</style>
