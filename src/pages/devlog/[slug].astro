---
import { getCollection, getEntry, render } from 'astro:content';
import Prose from '../../layouts/Prose.astro';
import { fmtDate, url } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('devlog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const game = post.data.game ? await getEntry(post.data.game) : undefined;
---
<Prose title={post.data.title} description={post.data.summary} kicker={`Devlog · ${fmtDate(post.data.date)}`}>
  <Content />
  {game && !game.data.draft && (
    <p><a class="btn primary" href={url(`games/${game.id}/`)} style="color:var(--sauce);text-decoration:none">▶ Play {game.data.title}</a></p>
  )}
  <p><a href={url('#devlog')}>← All devlog posts</a></p>
</Prose>
