---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { SITE, fmtDate, url } from '../../data/site';

export async function getStaticPaths() {
  const games = await getCollection('games', ({ data }) => !data.draft);
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}

const { game } = Astro.props;
const g = game.data;
const { Content } = await render(game);
const posts = (await getCollection('devlog', ({ data }) => !data.draft && data.game?.id === game.id)).sort((a, b) => +b.data.date - +a.data.date);
const src = /^https?:\/\//.test(g.embed) ? g.embed : url(g.embed);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: g.title,
  description: g.tagline,
  url: new URL(url(`games/${game.id}/`), Astro.site).href,
  datePublished: g.released.toISOString().slice(0, 10),
  genre: g.genre,
  gamePlatform: 'Web browser',
  playMode: 'SinglePlayer',
  author: { '@type': 'Person', name: SITE.handle, url: SITE.github },
  isAccessibleForFree: true,
};
---
<Base title={g.title} description={`${g.tagline} Play ${g.title} free in your browser.`}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="wrap game">
    <div class="stage" id="stage" style={`view-transition-name: screen-${game.id}; aspect-ratio: ${g.aspect}`}>
      {g.cover && !g.attract
        ? <Image src={g.cover} alt="" widths={[800, 1400]} sizes="(min-width: 980px) 90vw, 100vw" class="poster-art" />
        : <canvas data-attract={g.attract ?? 'default'} aria-hidden="true"></canvas>}
      <div class="poster" id="poster">
        <button class="btn primary start" id="startBtn" data-src={src}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg> Play
        </button>
        {g.warnings.length > 0 && <p class="warn" role="note">{g.warnings.join(' · ')}</p>}
        {!g.mobile && <p class="warn" role="note">Best with a keyboard</p>}
      </div>
    </div>

    <div class="info">
      <div class="title">
        <h1 id="game-title">{g.title}</h1>
        <p class="tagline">{g.tagline}</p>
      </div>
      <div class="row">
        <button class="btn sm" id="fsBtn">Fullscreen</button>
        <button class="btn sm" id="copyBtn">Copy link</button>
        {g.links.map((l) => <a class="btn sm" href={l.url} rel="noopener">{l.label} ↗</a>)}
      </div>
    </div>

    <div class="below">
      <dl class="kv">
        <div><dt>Controls</dt><dd>{g.controls}</dd></div>
        <div><dt>Length</dt><dd>{g.length}</dd></div>
        <div><dt>Built with</dt><dd>{g.engine}</dd></div>
        <div><dt>Released</dt><dd>{fmtDate(g.released)}</dd></div>
        {g.updated && <div><dt>Updated</dt><dd>{fmtDate(g.updated)}</dd></div>}
      </dl>
      <article class="prose"><Content /></article>
      {posts.length > 0 && (
        <ul class="mini-log" aria-label="Devlog posts">
          {posts.map((p) => <li><a href={url(`devlog/${p.id}/`)}><time>{fmtDate(p.data.date)}</time><strong>{p.data.title}</strong></a></li>)}
        </ul>
      )}
    </div>
  </div>
</Base>

<style>
  .game { padding-block: 12px clamp(64px, 9vw, 120px); }
  .stage { position: relative; background: #000; max-width: 100%; border-radius: var(--r); overflow: hidden; }
  .stage canvas, .stage .poster-art, .stage :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; border: 0; object-fit: cover; }
  .stage :global(iframe) { z-index: 2; background: #000; }
  .stage:fullscreen { aspect-ratio: auto !important; border-radius: 0; }
  @media (max-width: 640px) { .stage { aspect-ratio: 3 / 4 !important; } }
  .poster { position: absolute; inset: 0; z-index: 2; display: grid; place-content: center; justify-items: center; gap: 14px; padding: 16px; background: rgba(0, 0, 0, .35); text-align: center; }
  .start { min-height: 60px; font-size: 18px; padding: 0 32px; }
  .warn { margin: 0; padding: 8px 14px; border-radius: 999px; background: rgba(0, 0, 0, .75); font-size: 14px; }
  .info { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 20px 32px; margin-top: clamp(24px, 4vw, 40px); }
  h1 { font-size: clamp(40px, 6vw, 80px); margin: 0; }
  .tagline { margin: 12px 0 0; font-size: 19px; color: var(--ash); }
  .row { display: flex; flex-wrap: wrap; gap: 8px; }
  .below { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); margin-top: clamp(40px, 6vw, 72px); }
  @media (max-width: 860px) { .below { grid-template-columns: minmax(0, 1fr); } }
  .kv { display: grid; gap: 16px; margin: 0; align-content: start; }
  .kv dt { color: var(--ash); font-size: 14px; }
  .kv dd { margin: 2px 0 0; }
  .prose { max-width: 66ch; }
  .prose :global(> :first-child) { margin-top: 0; }
  .prose :global(h2), .prose :global(h3) { font-family: var(--f-body); font-weight: 700; font-size: 20px; margin: 28px 0 8px; letter-spacing: 0; }
  .prose :global(a) { color: var(--cheese); }
  .prose :global(code) { font-family: ui-monospace, Menlo, monospace; font-size: .88em; color: var(--cheese); }
  .mini-log { grid-column: 2; list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  @media (max-width: 860px) { .mini-log { grid-column: 1; } }
  .mini-log a { display: grid; gap: 2px; padding: 14px 18px; border-radius: 14px; background: var(--plate); text-decoration: none; }
  .mini-log a:hover { background: var(--plate-2); }
  .mini-log time { color: var(--ash); font-size: 14px; }
</style>

<script>
  import { mountAttract } from '../../scripts/attract';
  import { toast } from '../../scripts/core';

  const stage = document.getElementById('stage')!;
  const cv = stage.querySelector<HTMLCanvasElement>('canvas[data-attract]');
  if (cv) mountAttract(cv, cv.dataset.attract!, () => true, 0.6);

  const start = document.getElementById('startBtn') as HTMLButtonElement;
  start.addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.src = start.dataset.src!;
    f.title = `${document.getElementById('game-title')?.textContent ?? 'Game'} (playable)`;
    f.allow = 'fullscreen; gamepad; autoplay';
    f.setAttribute('allowfullscreen', '');
    stage.append(f);
    stage.classList.add('playing');
    document.getElementById('poster')?.remove();
    cv?.remove();
    f.addEventListener('load', () => f.focus());
  });

  document.getElementById('fsBtn')?.addEventListener('click', () => {
    if (!stage.classList.contains('playing')) start.click();
    stage.requestFullscreen?.().catch(() => toast('Fullscreen is not available here'));
  });
  document.getElementById('copyBtn')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.href.split('#')[0]);
      toast('Link copied');
    } catch {
      toast(location.href.split('#')[0]);
    }
  });
</script>
