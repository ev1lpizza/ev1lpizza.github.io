---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { SITE, fmtDate, url } from '../../data/site';

export async function getStaticPaths() {
  const games = await getCollection('games', ({ data }) => !data.draft);
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}

const { game } = Astro.props;
const g = game.data;
const { Content } = await render(game);
const posts = (await getCollection('devlog', ({ data }) => !data.draft && data.game?.id === game.id)).sort((a, b) => +b.data.date - +a.data.date);
const src = /^https?:\/\//.test(g.embed) ? g.embed : url(g.embed);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: g.title,
  description: g.tagline,
  url: new URL(url(`games/${game.id}/`), Astro.site).href,
  datePublished: g.released.toISOString().slice(0, 10),
  genre: g.genre,
  gamePlatform: 'Web browser',
  playMode: 'SinglePlayer',
  author: { '@type': 'Person', name: SITE.handle, url: SITE.github },
  isAccessibleForFree: true,
};
---
<Base title={g.title} description={`${g.tagline} Play ${g.title} free in your browser.`}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="wrap game">
    <a class="back mono" href={url('#rack')}>← Back to the rack</a>
    <div class="layout">
      <div class="stage scan" id="stage" style={`view-transition-name: screen-${game.id}; aspect-ratio: ${g.aspect}`}>
        {g.cover && !g.attract
          ? <Image src={g.cover} alt="" widths={[800, 1400]} sizes="(min-width: 980px) 70vw, 100vw" class="poster-art" />
          : <canvas data-attract={g.attract ?? 'default'} aria-hidden="true"></canvas>}
        <div class="poster" id="poster">
          <button class="btn primary start" id="startBtn" data-src={src}>
            <span aria-hidden="true">▶</span> Press start
          </button>
          {g.warnings.length > 0 && (
            <p class="warn mono" role="note"><strong>Heads up:</strong> {g.warnings.join(' · ')}</p>
          )}
          {!g.mobile && <p class="warn mono" role="note">Best on a computer with a keyboard.</p>}
        </div>
      </div>
      <aside class="info" aria-labelledby="game-title">
        <span class="mono kicker">{g.genre} · {g.released.getUTCFullYear()}</span>
        <h1 id="game-title">{g.title}</h1>
        <p class="tagline">{g.tagline}</p>
        <dl class="kv">
          <dt class="mono">Controls</dt><dd>{g.controls}</dd>
          <dt class="mono">Length</dt><dd>{g.length}</dd>
          <dt class="mono">Built with</dt><dd>{g.engine}</dd>
          <dt class="mono">Released</dt><dd>{fmtDate(g.released)}</dd>
          {g.updated && <><dt class="mono">Updated</dt><dd>{fmtDate(g.updated)}</dd></>}
        </dl>
        <div class="row">
          <button class="btn sm" id="fsBtn"><span aria-hidden="true">⛶</span> Fullscreen</button>
          <button class="btn sm" id="copyBtn">Copy link</button>
          {g.links.map((l) => <a class="btn sm" href={l.url} rel="noopener">{l.label} ↗</a>)}
        </div>
        <div class="tags">{g.tags.map((t) => <span>{t}</span>)}</div>
      </aside>
    </div>

    <div class="below">
      <article class="prose">
        <h2>About the game</h2>
        <Content />
      </article>
      {posts.length > 0 && (
        <aside>
          <h2>Devlog</h2>
          <ul class="mini-log">
            {posts.map((p) => <li><a href={url(`devlog/${p.id}/`)}><time class="mono">{fmtDate(p.data.date)}</time><strong>{p.data.title}</strong></a></li>)}
          </ul>
        </aside>
      )}
    </div>
  </div>
</Base>

<style>
  .game { padding-block: 28px 80px; }
  .back { display: inline-block; color: var(--ash); text-decoration: none; margin-bottom: 18px; }
  .back:hover { color: var(--cream); }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 340px; border: 1px solid var(--char); border-radius: 20px; background: var(--crust); overflow: hidden; }
  @media (max-width: 980px) { .layout { grid-template-columns: minmax(0, 1fr); } }
  .stage { position: relative; background: #0b0405; max-width: 100%; }
  .stage canvas, .stage .poster-art, .stage :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; border: 0; object-fit: cover; }
  .stage :global(iframe) { z-index: 2; background: #000; }
  .stage.playing::after { display: none; }
  .stage:fullscreen { aspect-ratio: auto !important; }
  @media (max-width: 640px) { .stage { aspect-ratio: 3 / 4 !important; } }
  .poster { position: absolute; inset: 0; z-index: 2; display: grid; place-content: center; justify-items: center; gap: 14px; padding: 16px; background: radial-gradient(closest-side, rgba(10,4,5,.55), transparent); text-align: center; }
  .start { height: 56px; font-size: 17px; padding: 0 28px; }
  .warn { margin: 0; padding: 8px 12px; border-radius: 8px; background: rgba(10,4,5,.82); color: var(--cream); max-width: 46ch; line-height: 1.6; }
  .warn strong { color: var(--cheese); }
  .info { padding: 26px; display: grid; gap: 16px; align-content: start; min-width: 0; }
  h1 { font-size: clamp(30px, 3.4vw, 42px); line-height: 1; margin: 0; }
  .tagline { margin: 0; color: color-mix(in oklab, var(--cream) 85%, var(--ash)); }
  .kv { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 8px 16px; margin: 0; font-size: 14.5px; }
  .kv dt { color: var(--ash); padding-top: 3px; }
  .kv dd { margin: 0; }
  .row { display: flex; flex-wrap: wrap; gap: 8px; }
  .below { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(28px, 5vw, 64px); margin-top: 56px; }
  @media (max-width: 980px) { .below { grid-template-columns: minmax(0, 1fr); } }
  .below h2 { font-size: 26px; margin: 0 0 14px; }
  .prose { max-width: 65ch; color: color-mix(in oklab, var(--cream) 90%, var(--ash)); }
  .prose :global(h3) { font-size: 18px; margin: 28px 0 8px; }
  .prose :global(a) { color: var(--cheese); }
  .prose :global(code) { font-family: var(--f-mono); font-size: .88em; color: var(--cheese); }
  .mini-log { list-style: none; margin: 0; padding: 0; }
  .mini-log a { display: grid; gap: 2px; padding: 12px 0; border-top: 1px solid var(--char); text-decoration: none; }
  .mini-log a:hover strong { color: var(--cheese); }
  .mini-log time { color: var(--ash); }
</style>

<script>
  import { mountAttract } from '../../scripts/attract';
  import { blip, toast } from '../../scripts/core';

  const stage = document.getElementById('stage')!;
  const cv = stage.querySelector<HTMLCanvasElement>('canvas[data-attract]');
  if (cv) mountAttract(cv, cv.dataset.attract!, () => true, 0.6);

  const start = document.getElementById('startBtn') as HTMLButtonElement;
  start.addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.src = start.dataset.src!;
    f.title = `${document.getElementById('game-title')?.textContent ?? 'Game'} (playable)`;
    f.allow = 'fullscreen; gamepad; autoplay';
    f.setAttribute('allowfullscreen', '');
    stage.append(f);
    stage.classList.add('playing');
    document.getElementById('poster')?.remove();
    cv?.remove();
    blip(392, 0.09);
    setTimeout(() => blip(523, 0.12), 90);
    f.addEventListener('load', () => f.focus());
  });

  document.getElementById('fsBtn')?.addEventListener('click', () => {
    if (!stage.classList.contains('playing')) start.click();
    stage.requestFullscreen?.().catch(() => toast('Fullscreen is not available here'));
  });
  document.getElementById('copyBtn')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.href.split('#')[0]);
      toast('LINK COPIED');
    } catch {
      toast(location.href.split('#')[0]);
    }
  });
</script>
