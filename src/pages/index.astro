---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Pie from '../components/Pie.astro';
import GameCard from '../components/GameCard.astro';

const games = (await getCollection('games', ({ data }) => !data.draft)).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || +b.data.released - +a.data.released,
);
const newest = [...games].sort((a, b) => +b.data.released - +a.data.released)[0];

// Empty state: three loose slices of the hero pie, waiting to become games.
const SLICES = 8;
const ghosts = [1, 4, 6].map((i, n) => {
  const mid = -Math.PI / 2 + (i + 0.5) * ((Math.PI * 2) / SLICES);
  const cx = Math.cos(mid) * 325, cy = Math.sin(mid) * 325;
  const tilt = [-18, 9, -4][n];
  const rot = 90 + tilt - ((mid + Math.PI) * 180) / Math.PI;
  return { i, transform: `rotate(${rot.toFixed(1)}) translate(${(-cx).toFixed(1)} ${(-cy).toFixed(1)})` };
});
---
<Base>
  <section class="hero" aria-labelledby="mark">
    <div class="hero-pie"><Pie slices={SLICES} /></div>
    <div class="wrap hero-text">
      <h1 id="mark" class="mark"><span>Ev1l</span> <span>Pizza</span></h1>
      <div class="sub-row">
        <p class="sub">Web games</p>
        <a class="cue" href="#games" aria-label="Jump to games">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15m0 0-6-6m6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="games" id="games" aria-labelledby="games-h">
    <div class="wrap">
      <div class="head">
        <h2 id="games-h">Games</h2>
        {games.length === 0 && <p class="muted">First ones coming soon.</p>}
      </div>
      {games.length > 0 ? (
        <div class="grid">
          {games.map((g) => <GameCard game={g} isNew={g.id === newest?.id} />)}
        </div>
      ) : (
        <div class="grid ghosts" aria-hidden="true">
          {ghosts.map((g) => (
            <div class="ghost">
              <svg viewBox="-330 -330 660 660">
                <g transform={g.transform} clip-path={`url(#pie-w${g.i})`}>
                  <use class="shade" href="#pie-art" x="-500" y="-500" width="1000" height="1000" />
                  <use class="real" href="#pie-art" x="-500" y="-500" width="1000" height="1000" />
                </g>
              </svg>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; min-height: max(560px, calc(100svh - 76px)); display: grid; align-items: end; overflow-x: clip; isolation: isolate; }
  .hero-pie { position: absolute; z-index: -1; width: min(62vw, max(560px, calc(100svh - 76px)) * 1.06); right: -5vw; top: 50%; translate: 0 -50%; }
  .hero-text { width: 100%; padding-bottom: clamp(40px, 8vh, 96px); }
  .mark { margin: 0; font-size: clamp(64px, 12vw, 200px); line-height: .84; letter-spacing: -.02em; text-transform: uppercase; }
  .mark span { display: block; }
  .sub-row { display: flex; align-items: center; gap: 18px; margin-top: clamp(18px, 2.4vw, 30px); }
  .sub { margin: 0; font-size: clamp(18px, 1.6vw, 22px); font-weight: 600; color: var(--ash); }
  .cue { flex: none; width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: var(--cheese); color: var(--ground); transition: transform .2s var(--ease-out); }
  .cue svg { width: 24px; height: 24px; }
  .cue:hover { transform: translateY(3px); }
  .cue:active { transform: scale(.94); }

  :global(:root.motion) .mark span, :global(:root.motion) .sub-row { animation: rise 1s var(--ease-out) both; }
  :global(:root.motion) .mark span:nth-child(2) { animation-delay: .08s; }
  :global(:root.motion) .sub-row { animation-delay: .22s; }
  @keyframes rise { from { opacity: 0; transform: translateY(28px); } }

  @media (max-width: 820px) {
    .hero { min-height: 0; align-items: start; grid-template-rows: auto auto; padding-bottom: 36px; }
    .hero-pie { position: relative; z-index: -1; width: 118vw; right: auto; top: auto; translate: none; margin: -6vw 0 -4vw -9vw; }
    .hero-text { padding-bottom: 0; }
    .mark { font-size: clamp(56px, 20vw, 120px); }
  }

  .games { padding-block: clamp(40px, 6vw, 96px) clamp(64px, 10vw, 140px); }
  .head { margin-bottom: clamp(24px, 4vw, 44px); }
  .head p { margin: 14px 0 0; font-size: 18px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: clamp(14px, 2vw, 22px); }
  .ghost { aspect-ratio: 4 / 3; border-radius: var(--r); background: var(--plate); display: grid; place-items: center; overflow: hidden; }
  .ghost svg { width: 78%; height: 78%; overflow: visible; transition: transform .6s var(--ease-out); }
  /* An empty slot: the slice as a debossed silhouette. Hover shows the real thing. */
  .shade { --p-crust: #34241e; --p-char: #34241e; --p-sauce: #291b17; --p-cheese: #291b17; --p-melt: #2d1e19; --p-pep: #1d1311; --p-pep-hi: #1d1311; --p-basil: #291b17; --p-basil-hi: #291b17; }
  .real { opacity: 0; transition: opacity .5s var(--ease-out); }
  .ghost:hover svg { transform: translateY(-8px) rotate(-4deg) scale(1.05); }
  .ghost:hover .real { opacity: 1; }
  :global(:root.evil) .shade { --p-sauce: #1c1430; --p-cheese: #1c1430; --p-melt: #1f1634; --p-pep: #130d22; --p-pep-hi: #130d22; --p-basil: #1c1430; --p-basil-hi: #1c1430; }
  @media (max-width: 700px) { .ghost:nth-child(n + 2) { display: none; } }
  @media (min-width: 701px) and (max-width: 1040px) { .ghost:nth-child(n + 3) { display: none; } }
</style>
